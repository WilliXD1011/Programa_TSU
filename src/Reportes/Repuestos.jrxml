	<subDataset name="Repuestos" uuid="f9b25e3a-3dab-44fa-91a9-f8a429d2a7ac">
		<queryString language="SQL">
			<![CDATA[SELECT
     repuestos.`codigo` AS repuestos_codigo,
     repuestos.`nombre` AS repuestos_nombre,
     repuestos.`cantidad` AS repuestos_cantidad,
     repuestos.`categoria` AS repuestos_categoria,
     repuestos.`precio` AS repuestos_precio,
     repuestos.`impuesto` AS repuestos_impuesto,
     repuestos.`ganancia` AS repuestos_ganancia,
     repuestos.`descripcion` AS repuestos_descripcion,
     repuestos.`stock_minimo` AS repuestos_stock_minimo,
     repuestos.`stock_maximo` AS repuestos_stock_maximo
FROM
     `repuestos` repuestos]]>
		</queryString>
